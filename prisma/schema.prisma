// ============================================================================
//  MN.KP — Portfolio · Blog · Affiliate Store Platform
//  Local sandbox schema (SQLite) — 1:1 mirror of supabase/schema.sql
// ----------------------------------------------------------------------------
//  MIRROR CONVENTIONS (see worklog Task 1 / BUILD CONTRACT §0.50):
//  · uuid PKs            → String @id @default(uuid())
//  · text[] arrays       → String holding a JSON array   ("[]")
//  · jsonb               → String holding a JSON object ("{}")
//  · numeric(10,2)       → Float
//  · enum CHECKs         → plain String (+ zod validation in src/lib/validation.ts)
//  · RLS / triggers / GIN&partial indexes → not applicable on SQLite;
//    enforced in the API layer instead (src/lib/auth.ts guards).
//  · Production keeps Supabase Auth; the sandbox adds local-auth columns
//    (passwordHash, emailVerified, verificationToken, resetToken*) to User.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
//  USERS (mirror of public.profiles + sandbox-only local-auth columns)
// ----------------------------------------------------------------------------
model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  fullName            String    @default("")
  displayName         String?
  headline            String?
  bio                 String?
  avatarUrl           String?
  location            String?
  websiteUrl          String?
  socials             String    @default("{}") // JSON object: {platform:url}
  role                String    @default("reader") // reader|author|editor|admin|advertiser
  onboardingCompleted Boolean   @default(false)
  onboardingStep      Int       @default(0) // 0..4
  marketingOptIn      Boolean   @default(true)
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?

  // sandbox local-auth (production: Supabase Auth manages these)
  passwordHash        String
  emailVerified       Boolean   @default(false)
  verificationToken   String?
  resetToken          String?
  resetTokenExpires   DateTime?

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  posts               Post[]
  inquiries           Inquiry[]
  affiliateClicks     AffiliateClick[]
  visitorSessions     VisitorSession[]
  settingsUpdated     SiteSetting[]
  adsSubmitted        Ad[]
}

// ----------------------------------------------------------------------------
//  CATEGORIES (shared by blog + store)
// ----------------------------------------------------------------------------
model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  scope       String   @default("blog") // blog|store
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  posts    Post[]
  products Product[]
}

// ----------------------------------------------------------------------------
//  POSTS
// ----------------------------------------------------------------------------
model Post {
  id                 String    @id @default(uuid())
  slug               String    @unique
  title              String
  excerpt            String?
  content            String    @default("") // markdown
  coverImageUrl      String?
  status             String    @default("draft") // draft|published|archived
  isFeatured         Boolean   @default(false)
  tags               String    @default("[]") // JSON array of strings
  readingTimeMinutes Int       @default(1)
  viewsCount         Int       @default(0)
  // SEO columns
  seoTitle           String?
  seoDescription     String?
  ogImageUrl         String?
  canonicalUrl       String?
  authorId           String?
  categoryId         String?
  publishedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  author   User?     @relation(fields: [authorId], references: [id], onDelete: SetNull)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt(sort: Desc)])
  @@index([categoryId])
  @@index([authorId])
  @@index([isFeatured, status])
}

// ----------------------------------------------------------------------------
//  PRODUCTS (affiliate store)
// ----------------------------------------------------------------------------
model Product {
  id             String   @id @default(uuid())
  slug           String   @unique
  name           String
  tagline        String?
  description    String? // markdown
  brand          String?
  merchant       String? // e.g. 'Amazon', 'Flipkart', 'MN.KP Digital'
  imageUrl       String?
  gallery        String   @default("[]") // JSON array of strings
  price          Float?
  compareAtPrice Float?
  currency       String   @default("INR")
  affiliateUrl   String
  pros           String   @default("[]") // JSON array of strings
  cons           String   @default("[]") // JSON array of strings
  keySpecs       String   @default("{}") // JSON object {key:value}
  rating         Float    @default(0) // 0..5
  reviewCount    Int      @default(0)
  status         String   @default("active") // active|draft|archived
  isFeatured     Boolean  @default(false)
  clicksCount    Int      @default(0) // maintained on affiliate_clicks insert (API layer)
  // ---- special offer (Task 14): buyer-facing promo the owner runs on
  // this product. Copy is always written from the BUYER's perspective.
  offerActive      Boolean   @default(false)
  offerTitle       String?
  offerDescription String?
  offerKind        String    @default("deal") // deal|cashback|coupon|bundle|giveaway
  offerCode        String? // coupon / claim code shown with a copy button
  offerStartsAt    DateTime?
  offerEndsAt      DateTime?
  categoryId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  clicks   AffiliateClick[]

  @@index([categoryId])
  @@index([price])
  @@index([status, isFeatured])
  @@index([status, offerActive])
}

// ----------------------------------------------------------------------------
//  INQUIRIES (contact / sponsorship / partnership)
// ----------------------------------------------------------------------------
model Inquiry {
  id           String    @id @default(uuid())
  userId       String?
  name         String
  email        String
  phone        String?
  type         String    @default("general") // general|sponsorship|partnership|advertising|support|feedback|venture|collab
  subject      String?
  message      String
  status       String    @default("new") // new|in_progress|replied|closed|spam
  priority     String    @default("normal") // low|normal|high|urgent
  internalNote String? // admin-only
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@index([email])
}

// ----------------------------------------------------------------------------
//  NEWSLETTER SUBSCRIBERS
// ----------------------------------------------------------------------------
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  status         String    @default("pending") // pending|confirmed|unsubscribed
  confirmToken   String?   @unique
  source         String    @default("blog") // blog|store|footer|lead_magnet
  subscribedAt   DateTime  @default(now())
  confirmedAt    DateTime?
  unsubscribedAt DateTime?
}

// ----------------------------------------------------------------------------
//  AFFILIATE CLICKS (outbound tracking)
// ----------------------------------------------------------------------------
model AffiliateClick {
  id        String   @id @default(uuid())
  productId String
  userId    String?
  sessionId String
  ipHash    String? // hashed, PII-safe
  userAgent String?
  referrer  String?
  device    String? // mobile|desktop|tablet
  country   String?
  clickedAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId, clickedAt(sort: Desc)])
  @@index([sessionId])
}

// ----------------------------------------------------------------------------
//  VISITOR SESSIONS (presence — REST fallback for the live counter)
// ----------------------------------------------------------------------------
model VisitorSession {
  id             String   @id @default(uuid())
  sessionId      String   @unique
  userId         String?
  path           String   @default("/")
  referrer       String?
  device         String? // mobile|desktop|tablet
  country        String?
  firstSeenAt    DateTime @default(now())
  lastSeenAt     DateTime @default(now())
  heartbeatCount Int      @default(1)
  isOnline       Boolean  @default(true)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([lastSeenAt])
  @@index([userId])
}

// ----------------------------------------------------------------------------
//  ADS — full ad management system (create from Admin & Developer, on/off,
//  placement control, schedule, priority, impression + click tracking).
//  Mirrors the ads table appended to supabase/schema.sql.
// ----------------------------------------------------------------------------
model Ad {
  id          String    @id @default(uuid())
  name        String
  // image|gif|sticker|text|marquee
  type        String    @default("image")
  // header-banner|blog-inline|blog-sidebar|between-cards|home-strip|store-side|footer-banner|product-inline|marquee|sticker
  placement   String    @default("blog-inline")
  title       String? // text ads / marquee caption / sticker label
  body        String? // text ad body copy
  imageUrl    String? // image|gif|sticker image
  imageAlt    String?
  images      String    @default("[]") // marquee: JSON array of image urls
  linkUrl     String? // click-through url
  linkLabel   String   @default("Learn more")
  active      Boolean   @default(true)
  priority    Int       @default(0) // higher renders first
  startAt     DateTime? // schedule window start (null = immediately)
  endAt       DateTime? // schedule window end (null = forever)
  impressions Int       @default(0)
  clicks      Int       @default(0)
  // ---- client campaigns + review workflow (Task 14) ----
  source        String    @default("owner") // owner|client — who this ad is for
  clientName    String? // contact person at the paying client
  clientCompany String?
  clientEmail   String?
  monthlyRate   Float? // agreed monthly charge (INR)
  planCode      String? // AdPlan.code this campaign belongs to
  reviewStatus  String    @default("approved") // pending|approved|rejected
  reviewNote    String? // approval note / rejection reason shown to the client
  submittedById String? // advertiser account that submitted (client ads)
  reviewedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  submittedBy User? @relation(fields: [submittedById], references: [id], onDelete: SetNull)

  @@index([placement, active])
  @@index([active, priority(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@index([reviewStatus])
  @@index([submittedById])
}

// ----------------------------------------------------------------------------
//  AD PLANS — monthly placement packages sold on the public #/advertise
//  page (Task 14). The owner edits prices/features from the Ad Manager;
//  prospective clients inquire via the advertising inquiry form.
// ----------------------------------------------------------------------------
model AdPlan {
  id           String   @id @default(uuid())
  code         String   @unique // e.g. 'starter' — referenced by Ad.planCode
  name         String
  description  String?
  priceMonthly Float    @default(0)
  currency     String   @default("INR")
  features     String   @default("[]") // JSON array of strings — selling points
  placements   String   @default("[]") // JSON array of AdPlacement codes
  isActive     Boolean  @default(true)
  isFeatured   Boolean  @default(false) // highlighted on #/advertise
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ----------------------------------------------------------------------------
//  VENTURES — "Ventures & Business Ideas" (Calicut Store, Chaliyam Connect,
//  MN.KP Digital, Project 195...). Managed from Admin & Developer; public
//  /ventures page + startup-idea inquiry form. Mirrors the ventures table
//  appended to supabase/schema.sql.
// ----------------------------------------------------------------------------
model Venture {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  tagline     String?
  description String? // markdown
  category    String   @default("venture") // venture|store|community|tech|product|service|media
  status      String   @default("live") // live|incubating|planned|idea|retired
  location    String?
  websiteUrl  String?
  imageUrl    String?
  highlights  String   @default("[]") // JSON array of strings
  collabRoles String   @default("[]") // JSON array of strings — roles wanted
  sortOrder   Int      @default(0)
  isFeatured  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([createdAt(sort: Desc)])
}

// ----------------------------------------------------------------------------
//  AUDIT LOG — every staff mutation snapshot (before/after) powering the
//  Admin & Developer Undo/Redo system + activity feed. Mirrors audit_log in
//  supabase/schema.sql.
// ----------------------------------------------------------------------------
model AuditLog {
  id        String    @id @default(uuid())
  userId    String?
  userName  String?
  // create|update|delete|toggle|undo|redo|import
  action    String
  // setting|ad|post|product|plan|inquiry|user|category|import
  entity    String
  entityId  String?
  label     String // human-readable target, e.g. "Ads settings" / post title
  before    String? // JSON snapshot before the change (null on create)
  after     String? // JSON snapshot after the change (null on delete)
  undoneAt  DateTime?
  redoneAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([entity, entityId])
  @@index([undoneAt])
}

// ----------------------------------------------------------------------------
//  SITE SETTINGS (maintenance mode & runtime flags; value = JSON string)
// ----------------------------------------------------------------------------
model SiteSetting {
  key            String   @id
  value          String   @default("{}") // JSON object
  updatedBy      String?
  updatedAt      DateTime @updatedAt

  updatedByUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)
}
